---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
const waHref = site.whatsapp ? `https://wa.me/${String(site.whatsapp).replace(/\D/g, '')}` : null;
const socials = [
  { name: 'Facebook', href: site.social.facebook, svg: '<path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.3 0-3.9 1.4-3.9 4v2.2H8V13.5h2.5V21h3z"/>' },
  { name: 'Instagram', href: site.social.instagram, svg: '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/>' },
  { name: 'YouTube', href: site.social.youtube, svg: '<path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.200 0-7.800.4A2.500 2.500 0 0 0 2.400 7.200C2 8.800 2 12 2 12s0 3.200.4 4.800a2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.4a2.500 2.500 0 0 0 1.800-1.800c.4-1.600.4-4.800.4-4.800s0-3.200-.4-4.800zM10 15V9l5.200 3L10 15z"/>' },
  { name: 'WhatsApp', href: waHref, svg: '<path fill="currentColor" d="M12 3a9 9 0 0 0-7.800 13.500L3 21l4.600-1.200A9 9 0 1 0 12 3zm0 16.300a7.300 7.300 0 0 1-3.800-1.100l-.3-.2-2.700.7.7-2.600-.2-.3A7.300 7.300 0 1 1 12 19.300zm4-5.400c-.2-.1-1.300-.6-1.500-.7s-.4-.1-.5.1-.6.7-.7.900-.3.100-.5 0a6 6 0 0 1-3-2.600c-.2-.4.2-.4.600-1.200.1-.1 0-.3 0-.4l-.7-1.600c-.2-.4-.4-.4-.5-.4h-.4c-.1 0-.4.1-.6.300s-.8.8-.8 1.900.8 2.200.9 2.300c.1.200 1.600 2.500 3.900 3.500 1.400.6 2 .7 2.700.6.4-.1 1.300-.5 1.500-1.100s.2-1 .1-1.100-.2-.2-.4-.3z"/>' },
];
---
<footer class="footer">
  <div class="container top">
    <a class="brand" href="/" data-reveal aria-label={`${site.name} - home`}>
      <img src="/brand/chci-logo-clear-480.webp" width="289" height="480" loading="lazy"
        alt="City Harvest Church International logo: flame above a green circle with a house, 'harvest house' beneath" />
      <span class="bt"><span class="display name">{site.name}</span><span class="slogan">{site.slogan}</span></span>
    </a>
    <nav aria-label="Footer" data-reveal style="--d:1">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </div>

  <div class="container info" data-reveal style="--d:2">
    {/* TODO: owner to supply the real account links in src/data/site.ts (social + whatsapp). Never guess URLs. */}
    <ul class="social" aria-label="Social media">
      {socials.map((s) => (
        <li>
          {s.href
            ? <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${site.short} on ${s.name}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.svg} /></a>
            : <span class="off" role="img" aria-label={`${s.name} link to be added`} title={`${s.name}: link to be added`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.svg} /></span>}
        </li>
      ))}
    </ul>
  </div>

  <div class="container legal label">
    <span>© {year} {site.name}</span>
    <span>Built by <a href="https://tagstudio.tech" target="_blank" rel="noopener noreferrer">TAG Studio</a></span>
  </div>
</footer>

<style>
  .footer { background: var(--color-green-deep); padding-top: var(--space-7); border-top: 1px solid rgb(255 255 255 / 0.1); }
  .top { display: grid; gap: var(--space-5); align-items: center; padding-bottom: var(--space-5); }
  .brand { display: flex; align-items: center; gap: var(--space-4); text-decoration: none; }
  .brand img { width: 44px; height: auto; filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 5px rgb(255 255 255 / 0.85)); }
  .bt { display: grid; gap: 6px; }
  .slogan { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent-gold); }
  .name { font-size: clamp(1.1rem, 4vw, 1.4rem); max-width: 22ch; line-height: 1.05; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  nav a { display: inline-block; padding: var(--space-2) 0; text-decoration: none; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255 255 255 / 0.85); transition: color 0.3s; }
  nav a:hover, nav a:focus-visible { color: var(--color-accent-gold); }
  .info { padding-block: var(--space-4); border-top: 1px solid rgb(255 255 255 / 0.14); }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-3); }
  .social a, .social .off { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.5); color: var(--color-white); transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.4s var(--ease-out); }
  .social a:hover, .social a:focus-visible { background: var(--color-white); color: var(--color-green-deep); border-color: var(--color-white); transform: translateY(-3px); }
  .social .off { border-style: dashed; opacity: 0.75; cursor: default; }
  .social svg { width: 20px; height: 20px; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-5); border-top: 1px solid rgb(255 255 255 / 0.14); padding-block: var(--space-4); color: rgb(255 255 255 / 0.65); }
  .legal a { color: var(--color-accent-gold); text-decoration: underline; text-underline-offset: 3px; }
  .legal a:hover, .legal a:focus-visible { color: var(--color-white); }
  @media (min-width: 900px) { .top { grid-template-columns: 1fr auto; } }
</style>
