---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <div class="brand" data-reveal>
      <div class="logo"><img src="/brand/chci-logo-clear-480.webp" width="289" height="480" loading="lazy"
        alt="City Harvest Church International logo: flame above a green circle with a house, 'harvest house' beneath" /></div>
      <p class="display name">{site.name}</p>
      <p class="label loc">{site.city}, {site.country}</p>
    </div>

    <nav aria-label="Footer" data-reveal style="--d:1">
      <p class="label head">Explore</p>
      <ul>{nav.map((n) => <li><a class="link-arrow" href={n.href}>{n.label}</a></li>)}</ul>
    </nav>

    <div data-reveal style="--d:2">
      <p class="label head">Visit</p>
      {/* TODO: CONFIRM ADDRESS, SERVICE TIMES, CONTACT before launch */}
      <p>{site.address ?? 'Address to be announced'}</p>
      <p>{site.serviceTimes ?? 'Service times to be announced'}</p>
    </div>
  </div>
  <div class="container legal label"><span>© {year} {site.name}</span></div>
</footer>

<style>
  .footer { background: var(--color-green-deep); padding-top: var(--space-9); border-top: 1px solid rgb(255 255 255 / 0.1); }
  .inner { display: grid; gap: var(--space-8); padding-bottom: var(--space-8); }
  .logo { width: 132px; margin-bottom: var(--space-5); }
  .name { font-size: clamp(1.6rem, 6vw, 2.4rem); max-width: 14ch; }
  .loc { margin-top: var(--space-3); color: var(--color-accent-gold); }
  .head { color: var(--color-accent-gold); margin-bottom: var(--space-4); }
  .logo img { width: 100%; height: auto; filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 5px rgb(255 255 255 / 0.85)); }
  ul { list-style: none; margin: 0; padding: 0; }
  p + p { margin-top: var(--space-2); }
  .legal { border-top: 1px solid rgb(255 255 255 / 0.16); padding-block: var(--space-5); color: rgb(255 255 255 / 0.65); }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr 1fr 1fr; } }
</style>
