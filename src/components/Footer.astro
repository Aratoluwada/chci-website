---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container top">
    <a class="brand" href="/" data-reveal aria-label={`${site.name} - home`}>
      <img src="/brand/chci-logo-clear-480.webp" width="289" height="480" loading="lazy"
        alt="City Harvest Church International logo: flame above a green circle with a house, 'harvest house' beneath" />
      <span class="display name">{site.name}</span>
    </a>
    <nav aria-label="Footer" data-reveal style="--d:1">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
  </div>

  <div class="container info" data-reveal style="--d:2">
    {/* TODO: CONFIRM CONTACT details before launch */}
    <p>{site.venue ? `${site.venue}, ` : ''}{site.address ?? `${site.city}, ${site.country}`}</p>
    {site.serviceTimes && <p>{site.serviceTimes.map((t) => `${t.day} ${t.time}`).join('  ·  ')}</p>}
  </div>

  <div class="container legal label">
    <span>© {year} {site.name}</span>
    <span>Built by <a href="https://tagstudio.tech" target="_blank" rel="noopener noreferrer">TAG Studio</a></span>
  </div>
</footer>

<style>
  .footer { background: var(--color-green-deep); padding-top: var(--space-7); border-top: 1px solid rgb(255 255 255 / 0.1); }
  .top { display: grid; gap: var(--space-5); align-items: center; padding-bottom: var(--space-5); }
  .brand { display: flex; align-items: center; gap: var(--space-4); text-decoration: none; }
  .brand img { width: 44px; height: auto; filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 5px rgb(255 255 255 / 0.85)); }
  .name { font-size: clamp(1.1rem, 4vw, 1.4rem); max-width: 22ch; line-height: 1.05; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  nav a { display: inline-block; padding: var(--space-2) 0; text-decoration: none; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255 255 255 / 0.85); transition: color 0.3s; }
  nav a:hover, nav a:focus-visible { color: var(--color-accent-gold); }
  .info { display: grid; gap: var(--space-1); padding-block: var(--space-4); border-top: 1px solid rgb(255 255 255 / 0.14); color: rgb(255 255 255 / 0.8); font-size: 0.95rem; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-5); border-top: 1px solid rgb(255 255 255 / 0.14); padding-block: var(--space-4); color: rgb(255 255 255 / 0.65); }
  .legal a { color: var(--color-accent-gold); text-decoration: underline; text-underline-offset: 3px; }
  .legal a:hover, .legal a:focus-visible { color: var(--color-white); }
  @media (min-width: 900px) { .top { grid-template-columns: 1fr auto; } .info { grid-auto-flow: column; justify-content: space-between; } }
</style>
