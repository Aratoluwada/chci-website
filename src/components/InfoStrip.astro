---
import { site } from '../data/site';
// TODO: values below render "To be announced" until the church supplies verified details.
const items = [
  { k: 'Where', v: site.address ?? `${site.city}, ${site.country}`, todo: !site.address && 'TODO: CONFIRM STREET ADDRESS' },
  { k: 'When', v: site.serviceTimes ?? 'Service times to be announced', todo: !site.serviceTimes && 'TODO: CONFIRM SERVICE TIME' },
  { k: 'Say hello', v: site.phone ?? site.email ?? 'Contact details to be announced', todo: !(site.phone || site.email) && 'TODO: ADD APPROVED CONTACT' },
];
---
<section class="strip" id="welcome" aria-label="Visit information">
  <div class="container grid">
    {items.map((it, i) => (
      <div class="cell" data-reveal style={`--d:${i}`} data-todo={it.todo || undefined}>
        <p class="label k">{it.k}</p>
        <p class="v">{it.v}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .strip { background: var(--color-surface); color: var(--color-text); }
  .grid { display: grid; }
  .cell { padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border); position: relative; }
  .cell:last-child { border-bottom: 0; }
  .k { color: var(--color-primary); margin-bottom: var(--space-2); }
  .v { font-size: clamp(1.25rem, 4.4vw, 1.75rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .cell::before {
    content: ''; position: absolute; left: 0; top: 0; height: 3px; width: 56px; background: var(--color-accent-orange);
    transition: width 0.6s var(--ease-out);
  }
  .cell:hover::before { width: 100%; }
  @media (min-width: 800px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .cell { padding: var(--space-7) var(--space-6) var(--space-7) 0; border-bottom: 0; border-right: 1px solid var(--color-border); }
    .cell + .cell { padding-left: var(--space-6); }
    .cell:last-child { border-right: 0; }
  }
</style>
