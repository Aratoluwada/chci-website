---
// Values (supplied by the owner)
const words = ['Faith', 'Love', 'Abilities', 'Virtue', 'Optimism', 'Unity', 'Righteousness'];
const text = words.join('   ·   ') + '   ·   ';
const reps = Array.from({ length: 3 });
---
<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <div class="set">{reps.map(() => <span class="display">{text}</span>)}</div>
    ))}
  </div>
</div>

<style>
  .marquee { background: var(--color-white); color: var(--color-primary); border-block: 1px solid var(--color-border); overflow: hidden; padding: var(--space-4) 0; }
  .track { display: flex; width: max-content; animation: scroll 38s linear infinite; }
  .set { display: flex; flex-shrink: 0; }
  .set span { font-size: clamp(1.4rem, 5vw, 2.4rem); white-space: pre; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
