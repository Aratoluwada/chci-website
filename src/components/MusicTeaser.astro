---
import { Image } from 'astro:assets';
import { musicPhoto } from '../data/photos';
import { songCards } from '../data/cards';
const cardImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/cards/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const cardImg = (n: string) => cardImgs[`../assets/cards/${n}`]?.default;
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = musicPhoto.image ? found[`../assets/photos/${musicPhoto.image}`]?.default : undefined;
// Decorative equaliser bars: deterministic heights/speeds so builds are stable.
const bars = Array.from({ length: 28 }, (_, i) => ({
  h: 28 + ((i * 37) % 62),
  d: ((i * 53) % 100) / 100,
  s: 0.9 + ((i * 29) % 70) / 100,
}));
---
<section class="music" aria-labelledby="music-h">
  <div class="eq" aria-hidden="true">
    {bars.map((b) => <i style={`--h:${b.h}%;--dl:-${b.d}s;--sp:${b.s}s`}></i>)}
  </div>
  <div class="container inner">
    <div class="copy">
      <p class="label eyebrow" data-reveal>Music</p>
      <h2 id="music-h" class="display title" data-words>Songs from our house</h2>
      <p class="text" data-reveal style="--d:2">Songs written and sung in our church, with lyrics you can read and sing along to.</p>
      <ul class="songs" data-reveal style="--d:3">
        {songCards.map((s) => (
          <li class="song">
          <a class="song__a" href={s.href ?? '/music'}>
            {cardImg(s.image) && <Image src={cardImg(s.image)} alt={s.alt} widths={[96, 160]} sizes="64px" class="song__img" loading="lazy" />}
            <span class="song__t"><strong>{s.title}</strong><span class="label">{s.note}</span></span>
          </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--gold" href="/music" data-reveal style="--d:3" data-magnetic>Explore the music <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
    {photo && (
      <figure class="shot" data-reveal style="--d:2">
        <Image src={photo} alt={musicPhoto.alt} widths={[360, 560, 760]} sizes="(min-width: 900px) 34vw, 78vw" loading="lazy" />
      </figure>
    )}
  </div>
</section>

<style>
  .music { position: relative; overflow: hidden; isolation: isolate; background: var(--color-ink); padding: var(--space-6) 0 calc(var(--space-6) + 56px); min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; }
  .eq { position: absolute; inset: auto 0 0 0; height: 80px; z-index: -1; display: flex; align-items: flex-end; gap: clamp(3px, 1vw, 10px); padding-inline: var(--gutter); opacity: 1; }
  .eq i {
    flex: 1; height: var(--h); background: linear-gradient(180deg, var(--color-accent-gold), var(--color-primary-bright) 70%, var(--color-primary));
    transform-origin: bottom; animation: bar var(--sp) ease-in-out var(--dl) infinite alternate; border-radius: 2px 2px 0 0; opacity: 0.55;
  }
  @keyframes bar { from { transform: scaleY(0.18); } to { transform: scaleY(1); } }
  .inner { width: 100%; display: grid; gap: var(--space-5); justify-items: start; position: relative; align-items: center; }
  .copy { display: grid; gap: var(--space-4); justify-items: start; }
  .shot { margin: 0; position: relative; width: min(52vw, 210px); aspect-ratio: 4 / 3.6; justify-self: start; }
  .shot::before { content: ''; position: absolute; inset: 14px -14px -14px 14px; background: var(--color-accent-orange); z-index: 0; transition: transform 0.6s var(--ease-out); }
  .shot:hover::before { transform: translate(8px, 8px); }
  .shot :global(img) { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @media (min-width: 900px) {
    .music { padding: var(--space-8) 0 calc(var(--space-7) + 64px); }
    .inner { grid-template-columns: 1.2fr 0.8fr; column-gap: var(--space-8); }
    .shot { width: min(100%, 420px); aspect-ratio: 4 / 4.4; justify-self: end; margin-right: 14px; }
  }
  .songs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .song__a { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2); color: inherit; text-decoration: none; }
  .song { border: 1px solid rgb(255 255 255 / 0.18); border-radius: 12px; background: rgb(255 255 255 / 0.05); }
  .song :global(.song__img) { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; }
  .song__t { display: grid; gap: 2px; }
  .song__t .label { font-size: 0.62rem; color: rgb(255 255 255 / 0.65); }
  .eyebrow { color: var(--color-accent-gold); }
  .title { line-height: 0.95; font-size: clamp(2rem, 7vw, 3.6rem); max-width: 14ch; }
  .text { max-width: 36ch; font-size: 1.15rem; color: rgb(255 255 255 / 0.9); }
</style>
