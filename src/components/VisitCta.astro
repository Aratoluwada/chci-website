---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { visitPhoto } from '../data/photos';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = visitPhoto.image ? photos[`../assets/photos/${visitPhoto.image}`]?.default : undefined;
---
<section class={`visit${photo ? ' has-photo' : ''}`} aria-labelledby="visit-h">
  {photo && (
    <div class="bg" aria-hidden="true">
      <Image src={photo} alt="" widths={[640, 1070]} sizes="100vw" loading="lazy" />
    </div>
  )}
  <div class="container inner">
    <p class="label eyebrow" data-reveal>Visit us</p>
    {/* TODO: owner to approve this closing line */}
    <h2 id="visit-h" class="display title" data-words>We'd love to meet you.</h2>
    <p class="where" data-reveal style="--d:2">{site.venue ? `${site.venue}, ` : ''}{site.address ?? `${site.city}, ${site.country}`}</p>
    <div class="actions" data-reveal style="--d:3">
      <a class="btn btn--primary pill" href={site.primaryCta.href} data-magnetic>{site.primaryCta.label} <span class="btn__arrow" aria-hidden="true">→</span></a>
      <a class="link-arrow" href={site.secondaryCta.href}>{site.secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .visit { position: relative; overflow: hidden; isolation: isolate; background: var(--color-ink); color: var(--color-white); padding: var(--space-8) 0 var(--space-7); min-height: calc(100svh - var(--header-h)); display: flex; align-items: flex-end; }
  /* Photo background with a black filter so the text stays readable */
  .bg { position: absolute; inset: 0; z-index: -2; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; display: block; }
  .visit::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.66) 50%, rgb(0 0 0 / 0.5) 100%); }
  @media (prefers-reduced-motion: no-preference) { .bg :global(img) { animation: slow-zoom 24s ease-in-out infinite alternate; } }
  @keyframes slow-zoom { to { transform: scale(1.08); } }
  .inner { width: 100%; display: grid; gap: var(--space-5); justify-items: start; position: relative; }
  .eyebrow { font-weight: 500; color: var(--color-accent-gold); }
  .title { font-stretch: 68%; line-height: 0.95; font-size: clamp(2rem, 7vw, 3.6rem); max-width: 20ch; color: var(--color-white); }
  .where { font-weight: 600; font-size: 1.2rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }
  .pill { padding-inline: var(--space-6); }
  .visit .link-arrow { color: var(--color-white); }
</style>
