---
import { events } from '../data/events';
import EventCard from './EventCard.astro';
const upcoming = events
  .filter((e) => new Date((e.endDate ?? e.date) + 'T23:59:59') >= new Date())
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);
---
<section class="ev" aria-labelledby="ev-h">
  <div class="container">
    <div class="head">
      <div>
        <p class="label eyebrow" data-reveal>Coming up</p>
        <h2 id="ev-h" class="display title" data-words>What's on</h2>
      </div>
      <a class="link-arrow all" href="/events" data-reveal>All services &amp; events <span aria-hidden="true">→</span></a>
    </div>

    {upcoming.length > 0 ? (
      <ul class:list={['cards', upcoming.length === 1 && 'one']}>
        {upcoming.map((e, i) => (
          <li data-reveal style={`--d:${i}`}>
            <EventCard event={e} solo={upcoming.length === 1} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty" data-reveal>
        {/* TODO: SUPPLY VERIFIED EVENTS in src/data/events.ts. Empty state shows until then. */}
        <span class="dot" aria-hidden="true"></span>
        <p>No upcoming events are listed right now. Check back soon, or visit the services and events page.</p>
      </div>
    )}
  </div>
</section>

<style>
  .ev { background: var(--color-surface-alt); color: var(--color-text); padding: var(--space-7) 0; }
  .head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); }
  .eyebrow { color: var(--color-primary); margin-bottom: var(--space-3); }
  .title { font-stretch: 68%; line-height: 0.95; font-size: clamp(2rem, 7vw, 3.6rem); color: var(--color-primary-dark); }
  .all { color: var(--color-primary-dark); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .empty { display: flex; gap: var(--space-4); align-items: center; padding: var(--space-6); background: var(--color-white); border: 1px dashed var(--color-border); max-width: 640px; }
  .empty p { font-size: 1.1rem; }
  .dot { flex: none; width: 14px; height: 14px; border-radius: 50%; background: var(--color-primary-bright); animation: pulse 2.2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgb(11 122 62 / 0.5); } 50% { box-shadow: 0 0 0 12px rgb(11 122 62 / 0); } }
  @media (min-width: 800px) { .ev { padding: var(--space-7) 0; } .cards:not(.one) { grid-template-columns: repeat(3, 1fr); } }
</style>
