---
import { Image } from 'astro:assets';
import { leadershipPhoto } from '../data/photos';
import { leaderCards } from '../data/cards';
const cardImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/cards/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const cardImg = (n: string) => cardImgs[`../assets/cards/${n}`]?.default;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = leadershipPhoto.image ? photos[`../assets/photos/${leadershipPhoto.image}`]?.default : undefined;
---
<section class:list={['lead', photo && 'has-photo']} aria-labelledby="lead-h">
  {photo && (
    <div class="bg" aria-hidden="true">
      <Image src={photo} alt="" widths={[640, 1070]} sizes="100vw" loading="lazy" />
    </div>
  )}
  <div class="container inner">
    <div class="copy">
    <p class="label eyebrow" data-reveal>Leadership</p>
    {/* TODO: owner to approve this wording; leader names, titles and photos come from the Leadership page */}
    <h2 id="lead-h" class="display title" data-words>Meet our pastors</h2>
    <p class="text" data-reveal style="--d:2">The pastors who care for our church family.</p>
    </div>
    <ul class="people" data-reveal style="--d:3" aria-label="Pastors">
      {leaderCards.map((c) => (
        <li class="person">
          {cardImg(c.image) && <Image src={cardImg(c.image)} alt={c.alt} widths={[240, 400]} sizes="(min-width: 900px) 14vw, 60vw" class="person__img" loading="lazy" />}
          <span class="person__t"><strong>{c.title}</strong><span class="label">{c.note}</span></span>
        </li>
      ))}
      <li class="person more">
        <a href="/leadership" class="more__a"><span class="more__t">See more pastors</span><span class="btn__arrow" aria-hidden="true">→</span></a>
      </li>
    </ul>
  </div>
</section>

<style>
  .lead { position: relative; isolation: isolate; overflow: hidden; background: var(--color-surface); color: var(--color-text); padding: var(--space-8) 0 var(--space-7); min-height: calc(100svh - var(--header-h)); display: flex; align-items: flex-end; }
  .inner { position: relative; width: 100%; display: grid; gap: var(--space-4); justify-items: start; }
  .eyebrow { color: var(--color-primary); }
  .title { line-height: 0.95; font-size: clamp(2rem, 7vw, 3.6rem); color: var(--color-primary-dark); max-width: 20ch; }
  .text { max-width: 34ch; font-size: 1.15rem; color: var(--color-muted); }
  .go { color: var(--color-primary-dark); }

  /* Photo background with a black filter; text sits on top, photo stays visible */
  .bg { position: absolute; inset: 0; z-index: -2; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; display: block; }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.68) 50%, rgb(0 0 0 / 0.5) 100%); }
  @media (min-width: 800px) { .bg::after { background: linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.66) 50%, rgb(0 0 0 / 0.5) 100%); } }
  .inner { gap: var(--space-5); }
  .copy { display: grid; gap: var(--space-4); justify-items: start; }
  .people { list-style: none; margin: 0; padding: 0 0 var(--space-2); width: 100%; display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; }
  .person { flex: 0 0 min(62vw, 230px); scroll-snap-align: start; border-radius: 12px; overflow: hidden; background: rgb(0 0 0 / 0.55); border: 1px solid rgb(255 255 255 / 0.18); backdrop-filter: blur(6px); display: grid; }
  .person :global(.person__img) { width: 100%; aspect-ratio: 4 / 4.4; object-fit: cover; object-position: 50% 25%; }
  .more { background: var(--color-primary-bright); border-color: transparent; }
  .more__a { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: var(--space-3); min-height: 100%; padding: var(--space-5); color: var(--color-white); text-decoration: none; font-weight: 800; font-size: 1.3rem; text-transform: uppercase; line-height: 1.05; }
  .person__t { display: grid; gap: 2px; padding: var(--space-3) var(--space-4); }
  .person__t .label { font-size: 0.62rem; color: rgb(255 255 255 / 0.65); }
  @media (min-width: 900px) { .inner { grid-template-columns: 1fr auto; align-items: end; column-gap: var(--space-8); } .people { width: auto; overflow: visible; } .person { flex: 0 0 190px; } }
  .has-photo { color: var(--color-white); }
  .has-photo .eyebrow { color: var(--color-accent-gold); }
  .has-photo .title { color: var(--color-white); }
  .has-photo .text { color: rgb(255 255 255 / 0.9); }
  .pill { padding-inline: var(--space-6); }
  .has-photo .go { color: var(--color-accent-gold); }

  @media (min-width: 800px) { .lead { padding: var(--space-9) 0; } }
</style>
