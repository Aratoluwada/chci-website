---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { pastors } from '../data/pastors';
import { leadershipPhoto } from '../data/photos';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/pastors/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = (n: string) => imgs[`../assets/pastors/${n}`]?.default;
---
<Base title="Leadership" description="Meet the pastors of City Harvest Church International in Abeokuta.">
  <PageHeader eyebrow="Our leadership" title="Meet our pastors" intro="The pastors who care for our church family." image={leadershipPhoto.image} alt={leadershipPhoto.alt} />

  <section class="intro" aria-labelledby="intro-h">
    <div class="container intro__in">
      <p class="label tag" data-reveal>The people behind CHCI</p>
      <h2 id="intro-h" class="display h" data-reveal>Called to care for the church family.</h2>
      <p class="intro__p" data-reveal style="--d:1">Every local assembly has one main under-shepherd who reports directly to Jesus and leads the church. Alongside our lead pastor, other pastors, equally called and anointed by the Holy Spirit, stand in various offices.</p>
    </div>
  </section>

  {pastors.map((p, i) => (
    <section class:list={['profile', i % 2 === 1 && 'profile--alt']} aria-labelledby={`p-${i}`}>
      <div class="container profile__in">
        <div class="profile__pic" data-reveal>
          {img(p.image) && <Image src={img(p.image)!} alt={p.alt} widths={[480, 800]} sizes="(min-width: 900px) 40vw, 92vw" class="pic" loading={i === 0 ? 'eager' : 'lazy'} />}
        </div>
        <div class="profile__t">
          <p class="label role" data-reveal>{p.role}</p>
          <h2 id={`p-${i}`} class="display name" data-reveal style="--d:1">{p.name}</h2>
          {p.bio.map((para, k) => <p class="bio" data-reveal style={`--d:${Math.min(k + 2, 4)}`}>{para}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section class="cta" aria-labelledby="cta-h">
    <div class="container cta__in">
      <h2 id="cta-h" class="display" data-reveal>Come and meet us.</h2>
      <p data-reveal style="--d:1">Join us on Sunday or Wednesday, or send us a message and we will reply.</p>
      <a class="btn btn--gold" href="/visit#contact" data-reveal style="--d:2">Get in touch <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .h { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-4); max-width: 20ch; }
  .intro { background: var(--color-white); color: var(--color-text); padding: var(--space-7) 0; }
  .intro__p { max-width: 62ch; font-size: 1.15rem; line-height: 1.6; color: var(--color-muted); margin: 0; }

  .profile { background: var(--color-surface); color: var(--color-text); padding: var(--space-6) 0; }
  .profile--alt { background: var(--color-white); }
  .profile__in { display: grid; gap: var(--space-5); align-items: center; }
  .profile__pic { border-radius: 14px; overflow: hidden; background: radial-gradient(120% 90% at 50% 100%, var(--color-primary-bright) 0%, var(--color-primary) 45%, var(--color-green-deep) 100%); }
  .profile__pic :global(.pic) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 100%; display: block; }
  .profile__t { display: grid; gap: var(--space-3); align-content: center; }
  .role { color: var(--color-primary); }
  .name { font-size: clamp(2rem, 6vw, 3.2rem); line-height: 0.98; }
  .bio { margin: 0; max-width: 56ch; font-size: 1.1rem; line-height: 1.6; color: var(--color-muted); }
  @media (min-width: 900px) {
    .profile { padding: var(--space-8) 0; }
    .profile__in { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: var(--space-9); }
    .profile--alt .profile__in { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
    .profile--alt .profile__pic { order: 2; }
  }

  .cta { background: var(--color-primary-dark); color: var(--color-white); padding: var(--space-8) 0; }
  .cta__in { display: grid; gap: var(--space-4); justify-items: start; }
  .cta h2 { font-size: clamp(2rem, 7vw, 3.4rem); }
  .cta p { margin: 0; color: rgb(255 255 255 / 0.85); font-size: 1.15rem; max-width: 46ch; }
</style>
