---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { pastors } from '../data/pastors';
import { leadershipPhoto } from '../data/photos';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/pastors/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = (n: string) => imgs[`../assets/pastors/${n}`]?.default;
const featured = pastors.filter((p) => p.featured);
const others = pastors.filter((p) => !p.featured);
---
<Base title="Leadership" description="Meet the pastors of City Harvest Church International in Abeokuta.">
  <PageHeader eyebrow="Our leaders" title="Meet our pastors" intro="The pastors who care for our church family." image={leadershipPhoto.image} alt={leadershipPhoto.alt} />

  <section class="pastors" aria-labelledby="pastors-h">
    <div class="container">
      <h2 id="pastors-h" class="visually-hidden">Our pastors</h2>
      <ul class="row row--feat">
        {featured.map((p, i) => (
          <li class="card" data-reveal style={`--d:${i}`}>
            {img(p.image) && <Image src={img(p.image)!} alt={p.alt} widths={[480, 800]} sizes="(min-width: 800px) 45vw, 92vw" class="card__img" loading={i === 0 ? 'eager' : 'lazy'} />}
            <div class="card__t">
              <h3 class="display">{p.name}</h3>
              <p class="label role">{p.role}</p>
              <p class="bio">{p.bio}</p>
            </div>
          </li>
        ))}
      </ul>
      {others.length > 0 && (
        <ul class="row row--more">
          {others.map((p, i) => (
            <li class="card" data-reveal style={`--d:${i}`}>
              {img(p.image) && <Image src={img(p.image)!} alt={p.alt} widths={[400, 640]} sizes="(min-width: 800px) 30vw, 92vw" class="card__img" loading="lazy" />}
              <div class="card__t">
                <h3 class="display">{p.name}</h3>
                <p class="label role">{p.role}</p>
                <p class="bio">{p.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .pastors { background: var(--color-surface); color: var(--color-text); padding: var(--space-7) 0 var(--space-9); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .row { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .row + .row { margin-top: var(--space-5); }
  .card { background: var(--color-white); border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; display: grid; align-content: start; min-width: 0; }
  .card :global(.card__img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; display: block; }
  .card__t { padding: var(--space-5); display: grid; gap: var(--space-2); }
  .card__t h3 { font-size: clamp(1.4rem, 4vw, 1.9rem); line-height: 1; color: var(--color-text); }
  .role { color: var(--color-primary); }
  .bio { margin: var(--space-2) 0 0; color: var(--color-muted); line-height: 1.55; }
  .row--feat .card__t h3 { font-size: clamp(1.7rem, 5vw, 2.4rem); }
  @media (min-width: 800px) {
    .row--feat { grid-template-columns: repeat(2, 1fr); }
    .row--more { grid-template-columns: repeat(3, 1fr); }
  }
</style>
