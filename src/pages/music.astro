---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Music">
  <PageHeader eyebrow="Songs from our house" title="Music" />
  <section class="empty">
    <div class="container" data-reveal>
      {/* TODO: replace this empty state with approved content (music) */}
      <p class="label tag">Coming soon</p>
      <p class="msg">Songs composed in the church, with their lyrics, will appear here once the church approves them for publishing.</p>
    </div>
  </section>
</Base>

<style>
  .empty { background: var(--color-surface); color: var(--color-text); padding: var(--space-9) 0; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .msg { font-size: clamp(1.2rem, 4vw, 1.8rem); font-weight: 600; max-width: 32ch; line-height: 1.3; }
</style>
