---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import songs from '../data/songs.json';
import { site } from '../data/site';
const list = [...songs].sort((a, b) => a.title.localeCompare(b.title));
const first = (s: (typeof songs)[number]) => s.stanzas[0].slice(0, 2).join(' / ');
---
<Base title="Music" description="Speak Songs: songs from City Harvest Church International, with lyrics you can search, read and sing along to.">
  <PageHeader eyebrow="Speak Songs" title="Music" intro="Songs written and sung in our church. Search by title or by any line you remember, then open a song to read the lyrics." image="music-keys.jpg" alt="A keyboardist playing during a worship service" />

  <section class="songs" aria-labelledby="songs-h">
    <div class="container">
      <h2 id="songs-h" class="visually-hidden">All songs</h2>
      <form class="search" role="search" onsubmit="return false" data-reveal>
        <label for="q" class="label">Search lyrics</label>
        <div class="field">
          <input id="q" type="search" placeholder="Search a title or a lyric line" autocomplete="off" />
          <button type="button" id="clear" class="clear" hidden aria-label="Clear search">Clear</button>
        </div>
        <p id="count" class="count" aria-live="polite">{list.length} songs</p>
      </form>

      <ul id="grid" class="grid">
        {list.map((s) => (
          <li class="song" data-slug={s.slug} data-title={s.title.toLowerCase()} data-text={s.stanzas.flat().join(' ').toLowerCase()}>
            <a class="open" href={`#${s.slug}`} data-open={s.slug}>
              <span class="song__t">{s.title}</span>
              <span class="song__p">{first(s)}</span>
              <span class="song__snip" hidden></span>
              <span class="song__go label">Read lyrics <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p id="none" class="none" hidden>No song matches that. Try fewer words or a different spelling.</p>
    </div>
  </section>

  {list.map((s) => (
    <dialog id={`d-${s.slug}`} class="reader" aria-labelledby={`h-${s.slug}`}>
      <div class="reader__bar">
        <p class="label">Speak Songs</p>
        <button type="button" class="reader__x" data-close aria-label="Close lyrics">Close ✕</button>
      </div>
      <h2 id={`h-${s.slug}`} class="display reader__h">{s.title}</h2>
      <div class="lyrics">
        {s.stanzas.map((st) => <p>{st.map((line) => <span>{line}</span>)}</p>)}
      </div>
    </dialog>
  ))}
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const clear = document.getElementById('clear') as HTMLButtonElement;
  const count = document.getElementById('count')!;
  const none = document.getElementById('none')!;
  const items = [...document.querySelectorAll<HTMLElement>('#grid .song')];
  const total = items.length;
  const norm = (t: string) => t.toLowerCase().replace(/[’‘]/g, "'");
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  function snippet(text: string, term: string) {
    const i = norm(text).indexOf(term);
    if (i < 0) return '';
    const a = Math.max(0, i - 40), b = Math.min(text.length, i + term.length + 60);
    return (a > 0 ? '… ' : '') + esc(text.slice(a, i)) + '<mark>' + esc(text.slice(i, i + term.length)) + '</mark>' + esc(text.slice(i + term.length, b)) + (b < text.length ? ' …' : '');
  }

  function run() {
    const term = norm(q.value.trim().replace(/\s+/g, ' '));
    let shown = 0;
    for (const li of items) {
      const snip = li.querySelector<HTMLElement>('.song__snip')!;
      const prev = li.querySelector<HTMLElement>('.song__p')!;
      const t = li.dataset.title!, body = li.dataset.text!;
      const hit = !term || t.includes(term) || body.includes(term);
      li.hidden = !hit;
      if (hit) shown++;
      if (term && hit && !t.includes(term)) {
        const full = li.dataset.full ?? (li.dataset.full = [...document.querySelectorAll(`#d-${li.dataset.slug} .lyrics span`)].map((s) => s.textContent).join(' / '));
        snip.innerHTML = snippet(full, term).replace(/ \/ /g, ' · ');
        snip.hidden = false; prev.hidden = true;
      } else { snip.hidden = true; prev.hidden = false; }
    }
    clear.hidden = !q.value;
    none.hidden = shown > 0;
    count.textContent = term ? `${shown} of ${total} songs` : `${total} songs`;
  }
  q.addEventListener('input', run);
  clear.addEventListener('click', () => { q.value = ''; run(); q.focus(); });

  // Lyrics reader: a native dialog, linkable as /music#song-name
  const dialogs = new Map([...document.querySelectorAll<HTMLDialogElement>('dialog.reader')].map((d) => [d.id.slice(2), d]));
  let current: HTMLDialogElement | null = null;
  function open(slug: string) {
    const d = dialogs.get(slug);
    if (!d || d.open) return;
    current = d; d.showModal(); d.scrollTop = 0;
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', '#' + a.dataset.open); open(a.dataset.open!); }));
  dialogs.forEach((d) => {
    d.addEventListener('click', (e) => { if (e.target === d || (e.target as HTMLElement).closest('[data-close]')) d.close(); });
    d.addEventListener('close', () => { if (location.hash) history.replaceState(null, '', location.pathname); current = null; });
  });
  const fromHash = () => { const h = decodeURIComponent(location.hash.slice(1)); if (h) open(h); };
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  .songs { background: var(--color-surface); color: var(--color-text); padding: var(--space-7) 0 var(--space-9); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .search { display: grid; gap: var(--space-2); max-width: 640px; margin-bottom: var(--space-6); }
  .search .label { color: var(--color-primary); }
  .field { position: relative; }
  input[type='search'] { width: 100%; font: inherit; font-size: 1.1rem; padding: 16px 78px 16px 18px; border: 2px solid var(--color-border); border-radius: 10px; background: var(--color-white); color: var(--color-text); -webkit-appearance: none; appearance: none; }
  input[type='search']::-webkit-search-cancel-button { display: none; }
  input[type='search']:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; border-color: var(--color-primary-bright); }
  .clear { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font: inherit; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; background: var(--color-surface-alt); color: var(--color-text); border: 0; border-radius: 6px; padding: 8px 10px; cursor: pointer; }
  .count { color: var(--color-muted); font-size: 0.95rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .song[hidden] { display: none; }
  .open { display: grid; gap: var(--space-2); align-content: start; height: 100%; padding: var(--space-5); background: var(--color-white); border: 1px solid var(--color-border); border-top: 4px solid var(--color-primary-bright); border-radius: 10px; color: inherit; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .open:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgb(0 0 0 / 0.1); }
  .open:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; }
  .song__t { font-weight: 900; font-size: 1.25rem; line-height: 1.1; text-transform: uppercase; }
  .song__p, .song__snip { color: var(--color-muted); font-size: 0.95rem; line-height: 1.4; overflow-wrap: anywhere; }
  .song__p[hidden], .song__snip[hidden] { display: none; }
  .song__snip :global(mark) { background: var(--color-accent-gold); color: var(--color-ink); padding: 0 2px; border-radius: 3px; }
  .song__go { color: var(--color-primary); margin-top: var(--space-2); }
  .none { margin-top: var(--space-5); font-size: 1.15rem; font-weight: 600; }

  .reader { width: min(640px, 100% - 24px); max-height: calc(100dvh - 24px); margin: auto; padding: 0; border: 0; border-radius: 14px; background: var(--color-white); color: var(--color-text); overflow: auto; }
  .reader::backdrop { background: rgb(0 0 0 / 0.72); }
  .reader__bar { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-5); background: var(--color-primary-dark); color: var(--color-white); }
  .reader__bar .label { color: var(--color-accent-gold); }
  .reader__x { font: inherit; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-white); background: transparent; border: 1px solid rgb(255 255 255 / 0.5); border-radius: 6px; padding: 8px 12px; cursor: pointer; }
  .reader__x:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; }
  .reader__h { font-size: clamp(1.8rem, 7vw, 2.6rem); padding: var(--space-6) var(--space-5) var(--space-3); color: var(--color-primary); }
  .lyrics { display: grid; gap: var(--space-5); padding: 0 var(--space-5) var(--space-7); font-size: 1.15rem; line-height: 1.55; }
  .lyrics :global(p) { margin: 0; display: grid; }
  .lyrics :global(span) { overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) { .open { transition: none; } }
</style>
