---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="About">
  <PageHeader eyebrow="Who we are" title="About" />
  <section class="empty">
    <div class="container" data-reveal>
      {/* TODO: replace this empty state with approved content (about) */}
      <p class="label tag">Coming soon</p>
      <p class="msg">This page will hold the church story, mission and beliefs once the church supplies and approves them.</p>
    </div>
  </section>
</Base>

<style>
  .empty { background: var(--color-surface); color: var(--color-text); padding: var(--space-9) 0; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .msg { font-size: clamp(1.2rem, 4vw, 1.8rem); font-weight: 600; max-width: 32ch; line-height: 1.3; }
</style>
