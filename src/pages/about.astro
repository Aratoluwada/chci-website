---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { missionStatement, story, tools, leadership, joinSteps, sow, flavour } from '../data/about';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = (n?: string | null) => (n ? imgs[`../assets/photos/${n}`]?.default : undefined);
const verse = 'Ye are the salt of the earth: but if the salt have lost his savour, wherewith shall it be salted? it is thenceforth good for nothing, but to be cast out, and to be trodden under foot of men.';
const storyPics = [
  { file: 'leadership-five.jpg', alt: 'Five church members standing together on the platform' },
  { file: 'services-sunday.jpg', alt: 'Worshippers standing in prayer during a service' },
  { file: 'music-keys.jpg', alt: 'A keyboardist playing during a worship service' },
];
---
<Base title="About" description="The story, mission, leadership and beliefs of City Harvest Church International in Abeokuta, and how to become part of the family.">
  <PageHeader eyebrow="Who we are" title="About" intro="The story of City Harvest Church International, what we are here to do, and how you can belong." image="visit-congregation.jpg" alt="The congregation seated and listening during a service" />

  <section class="mission" aria-labelledby="mission-h">
    <div class="container mission__in">
      <p class="label tag" data-reveal>Our mission</p>
      <h2 id="mission-h" class="visually-hidden">Mission statement</h2>
      <blockquote class="statement display" data-reveal style="--d:1"><span class="q q--open" aria-hidden="true">“</span>{missionStatement}<span class="q q--close" aria-hidden="true">”</span></blockquote>
    </div>
  </section>

  <section class="story" aria-labelledby="story-h">
    <div class="container">
      <p class="label tag" data-reveal>Our story</p>
      <h2 id="story-h" class="display h" data-reveal>How City Harvest began</h2>
      <div class="story__grid">
      <div class="story__text">
      <ol class="timeline is-collapsed" id="story-list">
        {story.map((s, i) => (
          <li data-reveal style={`--d:${Math.min(i, 3)}`}>
            <span class="when label">{s.when}</span>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <button type="button" class="morebtn" data-target="story-list" data-more="Read the full story" data-less="Show less" aria-expanded="false" aria-controls="story-list">Read the full story</button>
      </div>
      <div class="story__pics" aria-hidden="false">
        {storyPics.map((p) => img(p.file) && <Image src={img(p.file)!} alt={p.alt} widths={[500, 800]} sizes="30vw" class="pic" loading="lazy" />)}
      </div>
      </div>
    </div>
  </section>

  <section class="values" aria-labelledby="values-h">
    <div class="container">
      <p class="label tag" data-reveal>Our core values</p>
      <h2 id="values-h" class="display h" data-reveal>{site.slogan}</h2>
      <figure class="verse" data-reveal style="--d:1">
        <blockquote><span class="q q--sm" aria-hidden="true">“</span>{verse}<span class="q q--sm" aria-hidden="true">”</span></blockquote>
        <figcaption class="label">Matthew 5:13 (KJV)</figcaption>
      </figure>
      <p class="values__p" data-reveal style="--d:2">Our values spell <strong>FLAVOUR</strong>.</p>
      <ul class="flavour">
        {flavour.map((f, i) => (
          <li class="fl" tabindex="0" data-reveal style={`--d:${Math.min(i, 4)}`}>
            {img(f.image) && <Image src={img(f.image)!} alt="" widths={[500, 900]} sizes="(min-width: 900px) 25vw, 92vw" class="fl__img" loading="lazy" />}
            <span class="l display" aria-hidden="true">{f.letter}</span>
            <span class="w">{f.word}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-h">
    <div class="container">
      <p class="label tag" data-reveal>How we carry out the mission</p>
      <h2 id="tools-h" class="display h" data-reveal>Our three tools</h2>
      <ul class="toolgrid">
        {tools.map((t, i) => (
          <li class="tool" data-reveal style={`--d:${i}`}>
            {img(t.image) && <Image src={img(t.image)!} alt={t.alt} widths={[400, 700]} sizes="(min-width: 800px) 30vw, 92vw" class="tool__img" loading="lazy" />}
            <div class="tool__t">
              <h3 class="display">{t.name}</h3>
              <p>{t.text}</p>
              <p class="label ref">{t.ref}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="lead" aria-labelledby="lead-h">
    <div class="container lead__in">
      <div>
        <p class="label tag" data-reveal>Leadership</p>
        <h2 id="lead-h" class="display h" data-reveal>Who leads the church</h2>
      </div>
      <div>
        <p class="lead__p is-collapsed" id="lead-text" data-reveal style="--d:1">{leadership}</p>
        <button type="button" class="morebtn morebtn--lead" data-target="lead-text" data-more="Read more" data-less="Show less" aria-expanded="false" aria-controls="lead-text">Read more</button>
        <a class="btn btn--primary" href="/leadership" data-reveal style="--d:2">Meet our pastors <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="join" aria-labelledby="join-h">
    <div class="container">
      <p class="label tag" data-reveal>Membership</p>
      <h2 id="join-h" class="display h" data-reveal>Becoming part of the family</h2>
      <ol class="steps">
        {joinSteps.map((s, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="step__n display" aria-hidden="true">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sow" id="school-of-wisdom" aria-labelledby="sow-h">
    <div class="container">
      <p class="label tag" data-reveal>Foundation classes</p>
      <h2 id="sow-h" class="display h" data-reveal>School of Wisdom</h2>
      <p class="sow__intro" data-reveal style="--d:1">New members begin with the School of Wisdom (S.O.W.), {sow.length} classes that lay the foundations of the Christian faith.</p>
      <ul class="sowgrid is-collapsed" id="sow-list">
        {sow.map((c) => (
          <li class="course">
            <span class="code label">{c.code}</span>
            <h3>{c.title}</h3>
            <p>{c.purpose}</p>
          </li>
        ))}
      </ul>
      <button type="button" class="morebtn" data-target="sow-list" data-more={`Show all ${sow.length} classes`} data-less="Show fewer classes" aria-expanded="false" aria-controls="sow-list">Show all {sow.length} classes</button>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-h">
    <div class="container cta__in">
      <h2 id="cta-h" class="display">Come and see for yourself</h2>
      <p>We meet every Sunday and Wednesday at {site.venue}, Abeokuta.</p>
      <a class="btn btn--gold" href="/visit">Visit us <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<script>
  // "Read more" buttons: long blocks start short and open on request. Without JavaScript everything is shown.
  document.querySelectorAll<HTMLButtonElement>('.morebtn').forEach((btn) => {
    const target = document.getElementById(btn.dataset.target!);
    if (!target) return;
    btn.addEventListener('click', () => {
      const open = target.classList.toggle('is-collapsed') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less! : btn.dataset.more!;
      if (!open) target.closest('section')?.scrollIntoView({ block: 'start' });
    });
  });
</script>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .h { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-5); }
  section { padding: var(--space-7) 0; }

  .mission { background: var(--color-green-deep); color: var(--color-white); }
  .mission .tag { color: var(--color-accent-gold); }
  .mission__in { display: grid; gap: var(--space-5); }
  /* Classic curly double quotes: the opening pair looks like "66" and the closing pair like "99". A serif font is used for the marks only. */
  .q { font-family: Georgia, 'Times New Roman', Times, serif; font-weight: 700; line-height: 0; color: var(--color-accent-gold); }
  .statement .q { font-size: 2.6em; vertical-align: -0.32em; }
  .q--open { margin-right: 0.1em; }
  .q--close { margin-left: 0.08em; }
  .q--sm { font-size: 1.9em; vertical-align: -0.3em; color: var(--color-primary); }
  .statement { margin: 0; font-size: clamp(1.7rem, 5.6vw, 3.1rem); line-height: 1.05; max-width: 24ch; text-transform: none; text-wrap: balance; }

  .story { background: var(--color-surface); color: var(--color-text); }
  .story__pics { display: none; }
  .story__text { min-width: 0; display: grid; gap: var(--space-5); justify-items: start; }
  .morebtn { display: none; font: inherit; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; padding: 13px 20px; border-radius: 8px; cursor: pointer; background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary-bright); margin-top: var(--space-4); }
  .morebtn:hover { background: var(--color-primary-bright); color: var(--color-white); }
  .morebtn:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; }
  .story__text .morebtn { margin-top: 0; }
  :global(.js) .morebtn { display: inline-flex; }
  :global(.js) .timeline.is-collapsed > li:nth-child(n + 4) { display: none; }
  :global(.js) .sowgrid.is-collapsed > li:nth-child(n + 7) { display: none; }
  @media (max-width: 639px) { :global(.js) .sowgrid.is-collapsed > li:nth-child(n + 5) { display: none; } }
  :global(.js) .lead__p.is-collapsed { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .story, .sow, .lead { scroll-margin-top: var(--header-h); }
  @media (min-width: 900px) {
    .story__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); column-gap: var(--space-8); align-items: start; }
    .story__pics { display: grid; gap: var(--space-4); position: sticky; top: calc(var(--header-h) + var(--space-5)); }
    .story__pics :global(.pic) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 14px; display: block; }
  }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 var(--space-5); border-left: 3px solid var(--color-primary-bright); display: grid; gap: var(--space-5); max-width: 760px; }
  .timeline li { position: relative; display: grid; gap: var(--space-1); }
  .timeline li::before { content: ''; position: absolute; left: calc(-1 * var(--space-5) - 9px); top: 4px; width: 15px; height: 15px; border-radius: 50%; background: var(--color-primary-bright); border: 3px solid var(--color-surface); }
  .when { color: var(--color-primary); }
  .timeline p { margin: 0; font-size: 1.1rem; line-height: 1.55; }

  .values { background: var(--color-white); color: var(--color-text); }
  .verse { margin: 0 0 var(--space-4); padding-left: var(--space-5); border-left: 4px solid var(--color-primary-bright); max-width: 62ch; display: grid; gap: var(--space-2); }
  .verse blockquote { margin: 0; font-size: clamp(1.15rem, 3.6vw, 1.5rem); line-height: 1.45; font-weight: 600; color: var(--color-text); }
  .verse .label { color: var(--color-primary); }
  .values__p { margin: 0 0 var(--space-5); font-size: 1.15rem; color: var(--color-muted); }
  .flavour { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .fl { position: relative; isolation: isolate; overflow: hidden; border-radius: 12px; background: var(--color-green-deep); color: var(--color-white); min-height: 104px; padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-5); }
  .fl :global(.fl__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s var(--ease-out); }
  .fl::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(0 20 10 / 0.88) 0%, rgb(0 0 0 / 0.55) 100%); }
  .fl .l { font-size: 3.6rem; line-height: 0.9; color: var(--color-accent-gold); flex: 0 0 2.8rem; }
  .fl .w { font-weight: 800; font-size: 1.25rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .fl:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; }
  @media (min-width: 900px) {
    /* Desktop: seven tall panels side by side. The one you point at opens wider. */
    .flavour { display: flex; gap: var(--space-2); height: 440px; }
    .fl { flex: 1 1 0; min-width: 0; min-height: 0; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: var(--space-5) var(--space-4); transition: flex-grow 0.5s var(--ease-out); }
    .fl::before { background: linear-gradient(0deg, rgb(0 20 10 / 0.9) 0%, rgb(0 0 0 / 0.45) 100%); }
    .fl .l { font-size: clamp(3.4rem, 6vw, 5.4rem); flex: none; }
    .fl .w { font-size: 0.8rem; letter-spacing: 0.02em; }
    .fl:hover, .fl:focus-visible { flex-grow: 2.6; }
    .fl:hover :global(.fl__img), .fl:focus-visible :global(.fl__img) { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) { .fl, .fl :global(.fl__img) { transition: none; } }

  .tools { background: var(--color-surface-alt); color: var(--color-text); }
  .toolgrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .tool { border-radius: 14px; overflow: hidden; background: var(--color-white); display: grid; align-content: start; }
  .tool :global(.tool__img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .tool__t { padding: var(--space-5); display: grid; gap: var(--space-2); }
  .tool__t h3 { font-size: 1.6rem; color: var(--color-primary); }
  .tool__t p { margin: 0; line-height: 1.55; }
  .ref { color: var(--color-muted); }
  @media (min-width: 800px) { .toolgrid { grid-template-columns: repeat(3, 1fr); } }

  .lead { background: var(--color-surface); color: var(--color-text); }
  .lead__in { display: grid; gap: var(--space-5); align-items: start; }
  .lead__p { max-width: 62ch; font-size: 1.1rem; line-height: 1.6; margin: 0 0 var(--space-5); }
  .lead .h { margin-bottom: 0; }
  @media (min-width: 900px) { .lead__in { grid-template-columns: 0.8fr 1.2fr; column-gap: var(--space-8); } }

  .join { background: var(--color-white); color: var(--color-text); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .steps li { background: var(--color-surface); border-top: 4px solid var(--color-primary-bright); border-radius: 10px; padding: var(--space-5); display: grid; gap: var(--space-2); align-content: start; }
  .step__n { font-size: 2.4rem; color: var(--color-primary); line-height: 1; }
  .steps h3 { font-size: 1.2rem; font-weight: 800; }
  .steps p { margin: 0; color: var(--color-muted); line-height: 1.5; }
  @media (min-width: 800px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .sow { background: var(--color-surface-alt); color: var(--color-text); }
  .sow__intro { max-width: 56ch; font-size: 1.1rem; margin: 0 0 var(--space-5); color: var(--color-muted); }
  .sowgrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .course { background: var(--color-white); border: 1px solid var(--color-border); border-radius: 10px; padding: var(--space-4) var(--space-5); display: grid; gap: var(--space-1); align-content: start; }
  .code { color: var(--color-primary); }
  .course h3 { font-size: 1.1rem; font-weight: 800; line-height: 1.2; }
  .course p { margin: 0; color: var(--color-muted); font-size: 0.95rem; line-height: 1.45; }

  .cta { background: var(--color-primary-dark); color: var(--color-white); padding: var(--space-8) 0; }
  .cta__in { display: grid; gap: var(--space-4); justify-items: start; }
  .cta h2 { font-size: clamp(2rem, 7vw, 3.4rem); }
  .cta p { margin: 0; color: rgb(255 255 255 / 0.85); font-size: 1.15rem; }
</style>
