---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import { events } from '../data/events';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import { eventsHeaderPhoto, servicesPhotos } from '../data/photos';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const svcImg = (i: number) => { const n = servicesPhotos[i]?.image; return n ? imgs[`../assets/photos/${n}`]?.default : undefined; };
const upcoming = events
  .filter((e) => new Date((e.endDate ?? e.date) + 'T23:59:59') >= new Date())
  .sort((a, b) => a.date.localeCompare(b.date));
---
<Base title="Services & Events">
  <PageHeader eyebrow="Join us" title="Services & Events" image={eventsHeaderPhoto.image} alt={eventsHeaderPhoto.alt} />

  {site.serviceTimes && (
    <section class="intro" aria-labelledby="intro-h">
      <div class="container intro__in">
        <p class="label tag" data-reveal>Every week</p>
        <h2 id="intro-h" class="display h" data-reveal>Our weekly services</h2>
        <p class="lead" data-reveal style="--d:1">We gather twice a week, on Sunday and on Wednesday. Here is when and where to find us. Everyone is welcome.</p>
      </div>
    </section>
  )}

  {site.serviceTimes?.map((t, i) => (
    <section class:list={['svc', svcImg(i) && 'has-photo']} aria-labelledby={`svc-h-${i}`}>
      {svcImg(i) && <div class="bg" aria-hidden="true"><Image src={svcImg(i)!} alt="" widths={[640, 1070]} sizes="100vw" loading="lazy" /></div>}
      <div class="container inner">
        <p class="label tag" data-reveal>Every {t.day}</p>
        <h2 id={`svc-h-${i}`} class="display h" data-reveal>{t.name}</h2>
        <p class="time display" data-reveal style="--d:1">{t.time}</p>
        <p class="where" data-reveal style="--d:2">{site.venue ? `${site.venue}, ` : ''}{site.address}</p>
      </div>
    </section>
  ))}

  <section class="upcoming" aria-labelledby="up-h">
    <div class="container">
      <p class="label tag" data-reveal>Coming up</p>
      <h2 id="up-h" class="display h" data-reveal>Upcoming programmes</h2>
      {upcoming.length > 0 ? (
        <ul class="list">
          {upcoming.map((e, i) => <li data-reveal style={`--d:${i}`}><EventCard event={e} detail solo /></li>)}
        </ul>
      ) : (
        <p class="msg" data-reveal>No upcoming programmes are listed right now. Check back soon.</p>
      )}
    </div>
  </section>

</Base>

<style>
  .upcoming { background: var(--color-surface-alt); color: var(--color-text); padding: var(--space-7) 0; }
  .intro { background: var(--color-white); color: var(--color-text); padding: var(--space-7) 0; }
  .intro .h { margin-bottom: var(--space-3); }
  .lead { max-width: 46ch; font-size: 1.2rem; color: var(--color-muted); }
  .tag { color: var(--color-primary); margin-bottom: var(--space-2); }
  .h { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-5); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .msg { font-size: 1.2rem; font-weight: 600; }
  .svc { position: relative; isolation: isolate; overflow: hidden; background: var(--color-primary-dark); color: var(--color-white); padding: var(--space-8) 0; min-height: 60svh; display: flex; align-items: flex-end; }
  .inner { position: relative; width: 100%; }
  .svc .h { margin-bottom: var(--space-3); }
  .time { font-size: clamp(1.6rem, 5vw, 2.4rem); color: var(--color-accent-gold); }
  .where { margin-top: var(--space-4); color: rgb(255 255 255 / 0.85); max-width: 44ch; }
  .svc .tag { color: var(--color-accent-gold); }
  .bg { position: absolute; inset: 0; z-index: -1; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.7) 55%, rgb(0 0 0 / 0.58) 100%); }
</style>
