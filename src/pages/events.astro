---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import { events } from '../data/events';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import { eventsHeaderPhoto, servicesPhoto } from '../data/photos';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const svcImg = servicesPhoto.image ? imgs[`../assets/photos/${servicesPhoto.image}`]?.default : undefined;
const upcoming = events
  .filter((e) => new Date((e.endDate ?? e.date) + 'T23:59:59') >= new Date())
  .sort((a, b) => a.date.localeCompare(b.date));
---
<Base title="Services & Events">
  <PageHeader eyebrow="Join us" title="Services & Events" image={eventsHeaderPhoto.image} alt={eventsHeaderPhoto.alt} />

  <section class="upcoming" aria-labelledby="up-h">
    <div class="container">
      <p class="label tag" data-reveal>Coming up</p>
      <h2 id="up-h" class="display h" data-reveal>Upcoming programmes</h2>
      {upcoming.length > 0 ? (
        <ul class="list">
          {upcoming.map((e, i) => <li data-reveal style={`--d:${i}`}><EventCard event={e} detail solo /></li>)}
        </ul>
      ) : (
        <p class="msg" data-reveal>No upcoming programmes are listed right now. Check back soon.</p>
      )}
    </div>
  </section>

  {site.serviceTimes && (
    <section class:list={['regular', svcImg && 'has-photo']} aria-labelledby="reg-h">
      {svcImg && <div class="bg" aria-hidden="true"><Image src={svcImg} alt="" widths={[640, 1070]} sizes="100vw" loading="lazy" /></div>}
      <div class="container inner">
        <p class="label tag" data-reveal>Every week</p>
        <h2 id="reg-h" class="display h" data-reveal>Regular services</h2>
        <ul class="slots">
          {site.serviceTimes.map((t, i) => (
            <li data-reveal style={`--d:${i + 1}`}><span class="day display">{t.day}</span><span class="time">{t.time}</span></li>
          ))}
        </ul>
        <p class="where" data-reveal>{site.venue ? `${site.venue}, ` : ''}{site.address}</p>
      </div>
    </section>
  )}
</Base>

<style>
  .upcoming { background: var(--color-surface-alt); color: var(--color-text); padding: var(--space-7) 0; }
  .regular { background: var(--color-white); color: var(--color-text); padding: var(--space-7) 0; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-2); }
  .h { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-5); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .msg { font-size: 1.2rem; font-weight: 600; }
  .slots { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .slots li { display: grid; gap: var(--space-1); padding: var(--space-5); border-left: 6px solid var(--color-primary-bright); background: var(--color-surface); border-radius: 0 10px 10px 0; }
  .day { font-size: clamp(1.6rem, 5vw, 2.2rem); color: var(--color-primary); }
  .time { font-size: 1.25rem; font-weight: 600; }
  .where { margin-top: var(--space-5); color: var(--color-muted); }
  @media (min-width: 800px) { .slots { grid-template-columns: repeat(2, 1fr); } }
  .regular { position: relative; isolation: isolate; overflow: hidden; }
  .bg { position: absolute; inset: 0; z-index: -1; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.7) 55%, rgb(0 0 0 / 0.58) 100%); }
  .has-photo { color: var(--color-white); background: var(--color-primary-dark); }
  .has-photo .tag { color: var(--color-accent-gold); }
  .has-photo .day { color: var(--color-accent-gold); }
  .has-photo .slots li { background: rgb(0 0 0 / 0.5); border-left-color: var(--color-primary-bright); backdrop-filter: blur(6px); }
  .has-photo .where { color: rgb(255 255 255 / 0.8); }
</style>
