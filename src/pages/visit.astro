---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import PageHeader from '../components/PageHeader.astro';
import DraftTag from '../components/DraftTag.astro';
import { visitPhoto } from '../data/photos';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = visitPhoto.image ? photos[`../assets/photos/${visitPhoto.image}`]?.default : undefined;
---
<Base title="Visit Us">
  <PageHeader eyebrow="Plan your visit" title="Visit Us" />
  <span id="times"></span><span id="contact"></span>
  <section class="empty">
    <div class="container wrap">
      {photo && (
        <figure class="shot" data-reveal>
          <Image src={photo} alt={visitPhoto.alt} widths={[400, 640, 900]} sizes="(min-width: 900px) 40vw, 92vw" loading="eager" />
          <figcaption class="label">Our church family</figcaption>
        </figure>
      )}
      <div data-reveal>
      {/* TODO: replace this empty state with approved content (visit) */}
      <p class="label tag">Coming soon</p>
      <p class="msg">Address, map and contact details will appear here once verified.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .empty { background: var(--color-surface); color: var(--color-text); padding: var(--space-9) 0; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .msg { font-size: clamp(1.2rem, 4vw, 1.8rem); font-weight: 600; max-width: 32ch; line-height: 1.3; }
  .wrap { display: grid; gap: var(--space-6); align-items: center; }
  .shot { margin: 0; }
  .shot :global(img) { width: 100%; height: auto; display: block; }
  .shot figcaption { margin-top: var(--space-3); color: var(--color-primary); }
  @media (min-width: 900px) { .wrap { grid-template-columns: 1.2fr 1fr; gap: var(--space-8); } }
</style>
