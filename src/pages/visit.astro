---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<Base title="Visit Us">
  <PageHeader eyebrow="Plan your visit" title="Visit Us" />
  <span id="contact"></span>
  {site.address && (
    <section class="where" id="where" aria-labelledby="where-h">
      <div class="container">
        <p class="label tag" data-reveal>Where we meet</p>
        <h2 id="where-h" class="display w-title" data-reveal>{site.venue ?? 'Find us'}</h2>
        <address class="addr" data-reveal style="--d:1">{site.address}</address>
      </div>
    </section>
  )}
  {site.serviceTimes && (
    <section class="times" id="times" aria-labelledby="times-h">
      <div class="container">
        <p class="label tag" data-reveal>When we meet</p>
        <h2 id="times-h" class="display t-title" data-reveal>Service times</h2>
        <ul class="slots">
          {site.serviceTimes.map((t, i) => (
            <li data-reveal style={`--d:${i + 1}`}><span class="day display">{t.day}</span><span class="time">{t.time}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section class="empty">
    <div class="container" data-reveal>
      {/* TODO: replace this empty state with approved content (visit) */}
      <p class="label tag">Coming soon</p>
      <p class="msg">Map and contact details will appear here once verified.</p>
    </div>
  </section>
</Base>

<style>
  .empty { background: var(--color-surface); color: var(--color-text); padding: var(--space-9) 0; }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .msg { font-size: clamp(1.2rem, 4vw, 1.8rem); font-weight: 600; max-width: 32ch; line-height: 1.3; }
  .times { background: var(--color-white); color: var(--color-text); padding: var(--space-8) 0 var(--space-6); }
  .t-title { font-size: clamp(2rem, 7vw, 3.4rem); color: var(--color-text); margin-bottom: var(--space-5); }
  .slots { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .slots li { display: grid; gap: var(--space-1); padding: var(--space-5); border-left: 6px solid var(--color-primary-bright); background: var(--color-surface); border-radius: 0 10px 10px 0; }
  .day { font-size: clamp(1.6rem, 5vw, 2.2rem); color: var(--color-primary); }
  .time { font-size: 1.25rem; font-weight: 600; }
  @media (min-width: 800px) { .slots { grid-template-columns: repeat(2, 1fr); } }
  .where { background: var(--color-surface); color: var(--color-text); padding: var(--space-7) 0 0; }
  .w-title { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-3); }
  .addr { font-style: normal; font-size: 1.25rem; font-weight: 600; max-width: 34ch; line-height: 1.4; }
</style>
