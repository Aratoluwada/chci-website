---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import { visitHeaderPhoto, servicesPhotos } from '../data/photos';
const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = (n?: string | null) => (n ? imgs[`../assets/photos/${n}`]?.default : undefined);
// Photo boxes: file names live in src/assets/photos/. Captions are general, not church facts.
const tiles = [
  { file: 'visit-congregation.jpg', alt: 'The congregation seated and listening during a service', cap: 'Come as you are' },
  { file: 'events-header.jpg', alt: 'Young people gathered around a worship leader', cap: 'Worship together' },
  { file: 'services-sunday.jpg', alt: 'Worshippers standing in prayer', cap: 'Pray with us' },
];
const wa = site.whatsapp ? `https://wa.me/${String(site.whatsapp).replace(/\D/g, '')}` : null;
const directions = site.mapLink ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address ?? '')}`;
---
<Base title="Visit Us" description="Find City Harvest Church International in Abeokuta: where we meet, service times, a map, and a way to send us a message.">
  <PageHeader eyebrow="Come and see" title="Visit Us" intro="Come as you are. Here is where we meet, when we meet, and how to reach us." image={visitHeaderPhoto.image} alt={visitHeaderPhoto.alt} />

  {site.address && (
    <section class="where" id="where" aria-labelledby="where-h">
      <div class="container where__copy">
        <p class="label tag" data-reveal>Where we meet</p>
        <h2 id="where-h" class="display w-title" data-reveal>{site.venue ?? 'Find us'}</h2>
        <address class="addr" data-reveal style="--d:1">{site.address}</address>
        <div class="where__actions" data-reveal style="--d:2">
          <a class="btn btn--primary" href={directions} target="_blank" rel="noopener noreferrer">Get directions <span class="btn__arrow" aria-hidden="true">→</span></a>
          {site.mapEmbed && (
            <div class="views" role="group" aria-label="Map view">
              <button type="button" class="view is-on" data-t="m" aria-pressed="true">Map</button>
              <button type="button" class="view" data-t="k" aria-pressed="false">Satellite</button>
              <button type="button" class="view" data-t="p" aria-pressed="false">Terrain</button>
            </div>
          )}
        </div>
      </div>
      {site.mapEmbed && (
        <div class="container mapwrap" data-reveal style="--d:2">
        <div class="map">
          <iframe id="map-frame" title={`Map showing ${site.venue ?? 'the church'}`} src={site.mapEmbed} data-base={site.mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        </div>
      )}
    </section>
  )}

  <section class="tiles" aria-label="Photos from our services">
    <div class="container tiles__in">
      {tiles.map((t, i) => (
        <figure class="tile" data-reveal style={`--d:${i}`}>
          {img(t.file) && <Image src={img(t.file)!} alt={t.alt} widths={[400, 700]} sizes="(min-width: 800px) 30vw, 92vw" loading="lazy" />}
          <figcaption class="label">{t.cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  {site.serviceTimes && (
    <section class="times" id="times" aria-labelledby="times-h">
      <div class="container">
        <p class="label tag" data-reveal>When we meet</p>
        <h2 id="times-h" class="display t-title" data-reveal>Service times</h2>
        <ul class="slots">
          {site.serviceTimes.map((t, i) => (
            <li class:list={['slot', img(servicesPhotos[i]?.image) && 'has-photo']} data-reveal style={`--d:${i + 1}`}>{img(servicesPhotos[i]?.image) && <Image src={img(servicesPhotos[i]?.image)!} alt="" widths={[500, 900]} sizes="(min-width: 800px) 45vw, 92vw" class="slot__img" loading="lazy" />}<span class="name label">{t.name}</span><span class="day display">{t.day}</span><span class="time">{t.time}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="contact" id="contact" aria-labelledby="contact-h">
    <div class="container grid">
      <div class="contact__copy">
        <p class="label tag" data-reveal>Contact</p>
        <h2 id="contact-h" class="display t-title" data-reveal>Send us a message</h2>
        <p class="lead" data-reveal style="--d:1">Have a question, a prayer request or a note for the church? Write to us and we will reply.</p>
        {wa && <a class="btn btn--primary" href={wa} target="_blank" rel="noopener noreferrer" data-reveal style="--d:2">Chat on WhatsApp <span class="btn__arrow" aria-hidden="true">→</span></a>}
      </div>
      <form id="contact-form" class="form" method="post" novalidate data-endpoint={site.contactFormUrl ?? ''} data-reveal style="--d:2">
        <div class="row">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="row">
          <label for="f-email">Your email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="row">
          <label for="f-msg">Your message</label>
          <textarea id="f-msg" name="message" rows="6" required></textarea>
        </div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />
        <button class="btn btn--primary send" type="submit">Send message <span class="btn__arrow" aria-hidden="true">→</span></button>
        <p id="form-status" class="status" role="status" aria-live="polite"></p>
        {/* TODO: set contactFormUrl in src/data/site.ts so messages reach the church's inbox. */}
      </form>
    </div>
  </section>
</Base>

<script>
  const frame = document.getElementById('map-frame') as HTMLIFrameElement | null;
  const views = document.querySelectorAll<HTMLButtonElement>('.view');
  views.forEach((v) => v.addEventListener('click', () => {
    if (!frame) return;
    const u = new URL(frame.dataset.base!);
    u.searchParams.set('t', v.dataset.t!);
    frame.src = u.toString();
    views.forEach((o) => { const on = o === v; o.classList.toggle('is-on', on); o.setAttribute('aria-pressed', String(on)); });
  }));
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const say = (t: string, ok = false) => { status.textContent = t; status.className = 'status ' + (ok ? 'ok' : 'bad'); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!String(data.get('name')).trim() || !String(data.get('message')).trim() || !/^\S+@\S+\.\S+$/.test(String(data.get('email')))) {
      say('Please fill in your name, a valid email and your message.'); return;
    }
    if (data.get('_gotcha')) return;
    const url = form.dataset.endpoint;
    if (!url) { say('Messaging is not switched on yet. Please use WhatsApp for now.'); return; }
    btn.disabled = true; say('Sending…', true);
    try {
      const r = await fetch(url, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error(String(r.status));
      form.reset(); say('Thank you. Your message has been sent.', true);
    } catch { say('Your message could not be sent. Please try again or use WhatsApp.'); }
    finally { btn.disabled = false; }
  });
</script>

<style>
  .where, .contact, .times { scroll-margin-top: var(--header-h); }
  .tag { color: var(--color-primary); margin-bottom: var(--space-3); }
  .grid > * { min-width: 0; }
  .grid { display: grid; gap: var(--space-6); align-items: start; }
  @media (min-width: 900px) { .grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: var(--space-8); } }
  .where { background: var(--color-surface); color: var(--color-text); padding: var(--space-7) 0 0; }
  .where__copy { display: grid; gap: var(--space-3); justify-items: start; padding-bottom: var(--space-5); }
  .where__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
  .views { display: inline-flex; border: 2px solid var(--color-primary-bright); border-radius: 8px; overflow: hidden; }
  .view { font: inherit; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 12px 16px; background: var(--color-white); color: var(--color-primary); border: 0; cursor: pointer; }
  .view + .view { border-left: 2px solid var(--color-primary-bright); }
  .view.is-on { background: var(--color-primary-bright); color: var(--color-white); }
  .view:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: -3px; }
  .w-title { font-size: clamp(2rem, 7vw, 3.4rem); }
  .addr { font-style: normal; font-size: 1.25rem; font-weight: 600; max-width: 30ch; line-height: 1.4; }
  .mapwrap { padding-bottom: var(--space-7); }
  .map { width: 100%; height: 360px; background: var(--color-surface-alt); border-radius: 14px; overflow: hidden; border: 1px solid var(--color-border); }
  @media (min-width: 900px) { .map { height: 520px; } }
  .tiles { background: var(--color-surface-alt); padding: var(--space-6) 0; }
  .tiles__in { display: grid; gap: var(--space-4); }
  .tile { position: relative; margin: 0; border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 10; background: var(--color-primary-dark); }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0) 60%); }
  .tile figcaption { position: absolute; left: var(--space-4); bottom: var(--space-4); z-index: 1; color: var(--color-white); font-size: 0.85rem; }
  @media (min-width: 800px) { .tiles__in { grid-template-columns: repeat(3, 1fr); } .tile { aspect-ratio: 4 / 3; } }
  .slot { position: relative; isolation: isolate; overflow: hidden; }
  .slot.has-photo { background: var(--color-primary-dark); color: var(--color-white); min-height: 200px; align-content: end; }
  .slot :global(.slot__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .slot.has-photo::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.55) 100%); }
  .slot.has-photo .name { color: rgb(255 255 255 / 0.75); }
  .slot.has-photo .day { color: var(--color-accent-gold); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
  .times { background: var(--color-white); color: var(--color-text); padding: var(--space-7) 0; }
  .t-title { font-size: clamp(2rem, 7vw, 3.4rem); margin-bottom: var(--space-4); }
  .slots { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .slots li { display: grid; gap: var(--space-1); padding: var(--space-5); border-left: 6px solid var(--color-primary-bright); background: var(--color-surface); border-radius: 0 10px 10px 0; }
  .name { color: var(--color-muted); }
  .day { font-size: clamp(1.6rem, 5vw, 2.2rem); color: var(--color-primary); }
  .time { font-size: 1.25rem; font-weight: 600; }
  @media (min-width: 800px) { .slots { grid-template-columns: repeat(2, 1fr); } }
  .contact { background: var(--color-primary-dark); color: var(--color-white); padding: var(--space-8) 0; }
  .contact .tag { color: var(--color-accent-gold); }
  .contact .t-title { margin-bottom: var(--space-3); }
  .contact__copy { display: grid; gap: var(--space-3); justify-items: start; }
  .lead { color: rgb(255 255 255 / 0.85); font-size: 1.15rem; max-width: 40ch; }
  .form { display: grid; gap: var(--space-4); background: var(--color-white); color: var(--color-text); padding: var(--space-6); border-radius: 12px; }
  .row { display: grid; gap: var(--space-2); }
  .row label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); }
  input, textarea { width: 100%; font: inherit; font-size: 1.05rem; padding: 14px 16px; border: 2px solid var(--color-border); border-radius: 10px; background: var(--color-white); color: var(--color-text); }
  textarea { resize: vertical; min-height: 140px; }
  input:focus-visible, textarea:focus-visible { outline: 3px solid var(--color-accent-orange); outline-offset: 2px; border-color: var(--color-primary-bright); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .send { justify-self: start; }
  .send:disabled { opacity: 0.6; }
  .status { min-height: 1.4em; font-weight: 600; }
  .status.ok { color: var(--color-primary); }
  .status.bad { color: #b42318; }
</style>
